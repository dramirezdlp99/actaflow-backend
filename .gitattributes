# Los scripts de Unix deben llegar con LF aunque se editen en Windows.
mvnw text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.java text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.mjs text eol=lf
Dockerfile text eol=lf
# Contratos fijados: su sha256 en contracts.lock.json se calcula con LF.
contracts/** text eol=lf
contracts.lock.json text eol=lf
