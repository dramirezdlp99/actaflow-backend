# ActaFlow - Backend (identity-service y legal-case-service)
# Documenta las variables; no pongas valores reales aqui. En Windows guardalas como
# variables de usuario ([Environment]::SetEnvironmentVariable("NOMBRE", "valor", "User"))
# y despues cierra por completo IntelliJ (File > Exit y Quit en Toolbox).
# Cada servicio lee las suyas. Los secretos van por par de servicios y son distintos en local
# y en produccion. Nunca reutilices un secreto entre pares.

# --- Comunes a los dos servicios ---
# PostgreSQL (en produccion, Neon con conexion DIRECTA, sin -pooler, y sslmode=require).
# La misma base para los dos: cada servicio migra y usa su propio esquema (identity, legal_case).
ACTAFLOW_DB_URL=jdbc:postgresql://localhost:5432/actaflow
ACTAFLOW_DB_USERNAME=actaflow
ACTAFLOW_DB_PASSWORD=
# Ventana de tolerancia de las firmas, en segundos.
ACTAFLOW_HMAC_TOLERANCE_SECONDS=300

# --- identity-service (puerto web 9098, gRPC nativo 9198) ---
# Puertos por defecto: web 9098 y gRPC nativo 9198 (no hace falta definir nada).
# Secreto del par BFF -> identity-service. Minimo 32 caracteres.
# Mismo nombre y mismo valor en el frontend.
ACTAFLOW_IDENTITY_HMAC_SECRET=

# --- legal-case-service (puerto web 9097, gRPC nativo 9197) ---
# Puertos por defecto: web 9097 y gRPC nativo 9197 (no hace falta definir nada).
# Secreto del par BFF -> legal-case-service. Minimo 32 caracteres.
# Mismo nombre y mismo valor en el frontend.
ACTAFLOW_LEGAL_CASE_HMAC_SECRET=
# Motor de IA: grpc (nativo, local) o grpc-web (Render Free; el Dockerfile ya lo fija).
ACTAFLOW_ENGINE_TRANSPORT=grpc
ACTAFLOW_ENGINE_GRPC_TARGET=localhost:8102
ACTAFLOW_ENGINE_URL=http://localhost:8002
# Secreto del par legal-case-service -> motor. El mismo valor en el motor de IA.
ACTAFLOW_ENGINE_HMAC_SECRET=
